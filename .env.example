# Copy to .env for local runs (never commit .env).
# Create a bot via @BotFather to get the token.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlmNoPqRsTuVwXyZ

# Where to send the digest. Can be:
#   - your personal chat id (message @userinfobot to get it), or
#   - a channel like @my_ai_news_channel (add the bot as admin), or
#   - a group chat id (usually negative, e.g. -1001234567890)
TELEGRAM_CHAT_ID=123456789

# ---- AI takeaways (top-3 bullets per article) ----
# Anthropic API key. Get one at https://console.anthropic.com.
# If unset, the bot still runs but falls back to the feed blurb (no bullets).
ANTHROPIC_API_KEY=sk-ant-...
# Model used to write takeaways. Default is Haiku (cheap, fast). Bump to
# claude-sonnet-4-6 or claude-opus-4-8 for richer bullets at higher cost.
AINEWS_SUMMARY_MODEL=claude-haiku-4-5
# Set to 0/false to disable AI takeaways entirely.
AINEWS_SUMMARIZE=1

# ---- Delivery ----
# 1 = one Telegram post per article with the article image attached.
# 0 = post text only (no image).
AINEWS_PHOTOS=1
# Pause between per-article posts, milliseconds (Telegram rate-limit safety).
AINEWS_SEND_DELAY_MS=1000

# ---- Optional tuning (sensible defaults shown) ----
# Only include items published within this many hours.
AINEWS_LOOKBACK_HOURS=24
# Max articles per run. With one-post-per-article, ~10 keeps the chat readable.
AINEWS_MAX_ITEMS=10
# Cap of items taken from any single feed per run.
AINEWS_MAX_PER_FEED=8
# Per-feed network timeout (seconds).
AINEWS_TIMEOUT=20
# Path to the dedup state file.
AINEWS_STATE_FILE=state/seen.json
# Drop seen-entries older than this many days from state.
AINEWS_STATE_TTL_DAYS=45

# =====================================================================
# Mimi Helen Bot — eyedrop & eye-care reminders (separate bot)
# Reuses TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID above. For the friend's
# own bot, create a fresh token via @BotFather and set her chat id.
# =====================================================================
# Name used in greetings.
MIMIHELEN_FRIEND_NAME=Helen
# Reminder times (24h, in MIMIHELEN_TZ). 3-5 times/day is the goal.
MIMIHELEN_TIMES=08:00,12:30,16:00,20:00,22:30
# IANA timezone for the times above.
MIMIHELEN_TZ=Asia/Singapore
# Daily eyedrop goal, used for progress + streaks.
MIMIHELEN_DAILY_GOAL=4
# Treat a cron run as "on time" if within this many minutes of a slot.
MIMIHELEN_SLOT_TOLERANCE_MIN=30
# Tracker state file (doses + streak), committed back by the Action.
MIMIHELEN_STATE_FILE=state/mimihelen.json
# serve mode: getUpdates long-poll seconds.
MIMIHELEN_POLL_TIMEOUT=50
