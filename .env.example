# Copy to .env for local runs (never commit .env).
# Create a bot via @BotFather to get the token.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlmNoPqRsTuVwXyZ

# Where to send the digest. Can be:
#   - your personal chat id (message @userinfobot to get it), or
#   - a channel like @my_ai_news_channel (add the bot as admin), or
#   - a group chat id (usually negative, e.g. -1001234567890)
TELEGRAM_CHAT_ID=123456789

# ---- AI takeaways (top-3 bullets per article) ----
# Anthropic API key. Get one at https://console.anthropic.com.
# If unset, the bot still runs but falls back to the feed blurb (no bullets).
ANTHROPIC_API_KEY=sk-ant-...
# Model used to write takeaways. Default is Haiku (cheap, fast). Bump to
# claude-sonnet-4-6 or claude-opus-4-8 for richer bullets at higher cost.
AINEWS_SUMMARY_MODEL=claude-haiku-4-5
# Set to 0/false to disable AI takeaways entirely.
AINEWS_SUMMARIZE=1

# ---- Delivery ----
# 1 = one Telegram post per article with the article image attached.
# 0 = post text only (no image).
AINEWS_PHOTOS=1
# Pause between per-article posts, milliseconds (Telegram rate-limit safety).
AINEWS_SEND_DELAY_MS=1000

# ---- Optional tuning (sensible defaults shown) ----
# Only include items published within this many hours.
AINEWS_LOOKBACK_HOURS=24
# Max articles per run. With one-post-per-article, ~10 keeps the chat readable.
AINEWS_MAX_ITEMS=10
# Cap of items taken from any single feed per run.
AINEWS_MAX_PER_FEED=8
# Per-feed network timeout (seconds).
AINEWS_TIMEOUT=20
# Path to the dedup state file.
AINEWS_STATE_FILE=state/seen.json
# Drop seen-entries older than this many days from state.
AINEWS_STATE_TTL_DAYS=45


# ==========================================================================
#  AI JOBS (Singapore) bot  —  python -m aijobs
#  Shares ANTHROPIC_API_KEY (and, by default, the bot token) with the news
#  digest, but posts to its OWN Telegram channel.
# ==========================================================================
# The jobs feed posts here. Create a separate channel, add your bot as admin,
# and put its id/handle below (e.g. @my_ai_jobs_sg or -1001234567890).
# If left empty, the bot falls back to TELEGRAM_CHAT_ID (shared with news).
AIJOBS_CHAT_ID=@my_ai_jobs_sg
# Optional: run the jobs feed through a *different* bot. Leave empty to reuse
# TELEGRAM_BOT_TOKEN (the same bot can post to multiple channels).
AIJOBS_BOT_TOKEN=
# Only surface roles (re)posted within this many hours. Jobs move slower than
# news, so the default window is a week.
AIJOBS_LOOKBACK_HOURS=168
# Max jobs sent per run (one Telegram post each).
AIJOBS_MAX_ITEMS=15
# Per-board network timeout (seconds).
AIJOBS_TIMEOUT=20
# Path to the jobs dedup state file (separate from the news bot's).
AIJOBS_STATE_FILE=state/jobs_seen.json
# Drop seen-entries older than this many days from state.
AIJOBS_STATE_TTL_DAYS=90
# One-line AI "what this role is" note. Needs ANTHROPIC_API_KEY; set 0 to skip.
AIJOBS_SUMMARIZE=1
AIJOBS_SUMMARY_MODEL=claude-haiku-4-5
# Pause between per-job posts, milliseconds (Telegram rate-limit safety).
AIJOBS_SEND_DELAY_MS=1000
# Extra location keywords to accept beyond Singapore, comma-separated
# (e.g. "remote, apac"). Empty = strictly Singapore.
AIJOBS_EXTRA_LOCATIONS=
