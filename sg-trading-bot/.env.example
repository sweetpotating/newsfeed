# ─────────────────────────────────────────────────────────────────────────────
# sg-trading-bot configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Execution mode. Controls how far the engine is allowed to go.
#   backtest  — historical simulation only, no broker connection
#   paper     — connect to IBKR PAPER account (or built-in simulator), place sim orders
#   live      — connect to a FUNDED account and place REAL orders (requires extra gate below)
SGTRADER_MODE=paper

# Hard live-trading safety gate. Live orders are refused unless BOTH:
#   (1) SGTRADER_MODE=live  AND  (2) this is set to the exact phrase below.
# This exists so live trading can never be enabled by accident.
SGTRADER_LIVE_CONFIRM=

# ── Interactive Brokers (TWS or IB Gateway) ─────────────────────────────────
# Run TWS/IB Gateway locally. Paper trading uses port 7497 (TWS) / 4002 (Gateway).
# Live uses 7496 (TWS) / 4001 (Gateway). Enable the API in TWS settings.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=11
# Optional: your IBKR account id (e.g. DU1234567 for paper, U1234567 for live)
IBKR_ACCOUNT=

# ── Market data ──────────────────────────────────────────────────────────────
# Provider for historical/daily bars: ibkr | yfinance | synthetic
# 'synthetic' needs no network or account and is used for offline testing/demo.
SGTRADER_DATA_PROVIDER=yfinance

# In PAPER mode, which broker to use:
#   simulator — built-in offline simulator (default, no account needed)
#   ibkr      — route paper orders through your real IBKR *paper* account
#               (exercises the live order path with zero financial risk —
#                the recommended final check before going live)
SGTRADER_PAPER_BROKER=simulator

# ── Notifications (optional) ─────────────────────────────────────────────────
# Get rebalance summaries and risk alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
