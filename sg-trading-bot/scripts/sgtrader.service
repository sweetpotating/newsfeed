# sg-trading-bot — one-shot rebalance run, triggered by sgtrader.timer.
#
# Install (edit the paths/user first):
#   sudo cp scripts/sgtrader.service /etc/systemd/system/
#   sudo cp scripts/sgtrader.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sgtrader.timer
#   systemctl list-timers sgtrader.timer        # confirm next run
#   journalctl -u sgtrader.service -f           # watch logs
[Unit]
Description=sg-trading-bot rebalance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ↓↓↓ EDIT these three to match your VPS user and install path ↓↓↓
User=ubuntu
WorkingDirectory=/home/ubuntu/newsfeed/sg-trading-bot
ExecStart=/home/ubuntu/newsfeed/sg-trading-bot/.venv/bin/python -m sgtrader rebalance
# Loads SGTRADER_MODE, IBKR_*, TELEGRAM_* etc. from the project .env
EnvironmentFile=/home/ubuntu/newsfeed/sg-trading-bot/.env
# Don't let a single bad run thrash; the timer will retry tomorrow.
TimeoutStartSec=600
